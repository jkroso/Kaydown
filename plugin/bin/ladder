#!/bin/bash
# Show a Markdown page to the user in Ladder, and wait for the user to send it back.
#
# An agent writes a page, shows it, and waits:
#
#     ladder show plan.md
#     ladder wait plan.md
#
# `wait` talks to Ladder through files in one folder. Ladder's agent.jl says
# what each file is for.

set -u

usage() {
  cat <<'EOF'
Usage:
  ladder show <file or folder>
      Open it in Ladder, in front of the other windows.

  ladder wait <file.md> [--as <name>] [--timeout <seconds>]
      Wait until the user presses "Nudge" in Ladder. Then print the lines that
      the user changed in the file, and stop.
      --as <name>          What Ladder calls you on its Nudge button.
      --timeout <seconds>  Stop waiting after this long. The exit code is then 2.

Exit codes: 0 done, 1 an error, 2 the time ran out, 3 Ladder can't take part.
EOF
}

fail() { echo "ladder: $1" >&2; exit "${2:-1}"; }

# The path of a file with no symbolic links in it, the way Ladder names it
real() {
  if [ -x /bin/realpath ]; then /bin/realpath "$1"
  else (cd "$(dirname "$1")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")")
  fi
}

app="${LADDER_APP:-Ladder}"

# True when a Ladder that can send a page to an agent is open. It names a file for its process as it opens.
ladder_open() {
  for f in "$1"/*.app; do
    [ -e "$f" ] || continue
    pid="$(basename "$f" .app)"
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

show() {
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  [ -e "$1" ] || fail "there's no file or folder at $1"
  open -a "$app" "$(real "$1")" 2>/dev/null || fail "Ladder isn't installed on this Mac. It's at https://github.com/jkroso/Ladder" 3
}

wait_for() {
  page="" name="${LADDER_AGENT:-}" limit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) [ $# -ge 2 ] || fail "--as needs a name"; name="$2"; shift 2 ;;
      --timeout) [ $# -ge 2 ] || fail "--timeout needs a number of seconds"; limit="$2"; shift 2 ;;
      -*) fail "wait doesn't know the option $1" ;;
      *) page="$1"; shift ;;
    esac
  done
  [ -n "$page" ] || { usage >&2; exit 1; }
  [ -f "$page" ] || fail "there's no file at $page. Write the page first."
  case "$limit" in ''|*[!0-9]*) fail "--timeout needs a whole number of seconds" ;; esac
  # Claude Code sets CLAUDECODE in the commands that it runs
  [ -n "$name" ] || { [ -n "${CLAUDECODE:-}" ] && name="Claude" || name="the agent"; }
  page="$(real "$page")"

  dir="$HOME/Library/Application Support/Ladder/agents"
  mkdir -p "$dir" || fail "can't make the folder $dir"
  me="$dir/$$"
  trap 'rm -f "$me.wait" "$me.seen" "$me.sent" "$me.part" "$me.new"' EXIT
  trap 'exit 130' INT TERM HUP
  # Ladder reads the file as soon as it's there, so it gets its name when it's whole
  printf '%s\n%s\n' "$page" "$name" > "$me.new" && mv "$me.new" "$me.wait" || fail "can't write in $dir"

  opened=0
  while [ ! -f "$me.sent" ]; do
    sleep 0.2
    if [ ! -f "$me.seen" ]; then
      # A Ladder that's open marks the wait as seen within a second. One that's busy takes
      # longer: it can be waiting for the user to answer a question from macOS.
      if ladder_open "$dir"; then
        :
      elif [ $opened -eq 0 ] && [ $SECONDS -ge 3 ]; then
        opened=$SECONDS
        open -g -a "$app" "$page" 2>/dev/null || fail "Ladder isn't installed on this Mac. It's at https://github.com/jkroso/Ladder" 3
      elif [ $opened -gt 0 ] && [ $((SECONDS - opened)) -ge 30 ]; then
        fail "Ladder opened, but it didn't answer in 30 seconds. Ask the user to look at Ladder: it may show a question from macOS that they must answer, or it may be a version from before it could send a page to an agent. Then run this again." 3
      fi
    fi
    if [ "$limit" -gt 0 ] && [ $SECONDS -ge "$limit" ]; then
      echo "The user hasn't sent $page yet." >&2
      exit 2
    fi
  done
  cat "$me.sent"
}

case "${1:-}" in
  show) shift; show "$@" ;;
  wait) shift; wait_for "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "ladder: there's no command '$1'" >&2; usage >&2; exit 1 ;;
esac
